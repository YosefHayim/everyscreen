{
  "name": "everyscreen",
  "version": "0.1.0",
  "description": "Local CLI and live dashboard that runs your web app on many device sizes at once, with layout checks and one-line results for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YosefHayim/everyscreen.git"
  },
  "homepage": "https://everyscreen.jtslabs.dev",
  "type": "module",
  "bin": {
    "everyscreen": "./dist/cli.mjs"
  },
  "exports": {
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "default": "./dist/playwright.mjs"
    },
    "./reporter": {
      "types": "./dist/reporter.d.mts",
      "default": "./dist/reporter.mjs"
    },
    "./theme.css": "./src/dashboard/ui/theme.css"
  },
  "files": [
    "dist",
    "src/skill/SKILL.md",
    "src/dashboard/ui/theme.css"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm run \"/^dev:(hub|dashboard)$/\"",
    "dev:hub": "tsx watch src/cli/cli.ts start",
    "dev:dashboard": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "prod": "pnpm build && node dist/cli.mjs start",
    "build": "tsdown && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check && knip",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "check": "biome check && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build:site"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.14",
    "playwright": "1.64.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": "~1.64.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@hookform/resolvers": "6.0.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.5.11",
    "knip": "6.43.0",
    "msw": "3.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.9",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
